{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CORE_CPP_TESTING": "ON",
        "CORE_CPP_PEDANTIC": "ON",
        "CORE_CPP_WERROR": "ON"
      }
    },
    {
      "name": "unix",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "clang-debug",
      "displayName": "Clang, Debug",
      "inherits": "unix",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "clang-release",
      "displayName": "Clang, Release",
      "inherits": "unix",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "gcc-debug",
      "displayName": "GCC, Debug",
      "inherits": "unix",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC, Release",
      "inherits": "unix",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "clang-asan-ubsan",
      "displayName": "Clang, AddressSanitizer + UndefinedBehaviorSanitizer",
      "inherits": "unix",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CORE_CPP_SANITIZERS": "address;undefined"
      }
    },
    {
      "name": "clang-tsan",
      "displayName": "Clang, ThreadSanitizer",
      "inherits": "unix",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CORE_CPP_SANITIZERS": "thread"
      }
    },
    {
      "name": "clang-tidy",
      "displayName": "Clang, Debug, clang-tidy on every core-cpp target",
      "inherits": "unix",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CORE_CPP_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "clang-coverage",
      "displayName": "Clang, source-based coverage (no compiler cache)",
      "inherits": "unix",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CORE_CPP_COVERAGE": "ON",
        "USE_COMPILER_CACHE": "OFF"
      }
    },
    {
      "name": "clang-tracy",
      "displayName": "Clang, RelWithDebInfo, Tracy profiler",
      "inherits": "unix",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "clang++",
        "CORE_CPP_WITH_TRACY": "ON"
      }
    },
    {
      "name": "appleclang-debug",
      "displayName": "AppleClang, Debug",
      "inherits": "unix",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "appleclang-release",
      "displayName": "AppleClang, Release",
      "inherits": "unix",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "cl-debug",
      "displayName": "MSVC, Debug",
      "inherits": "windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "cl-release",
      "displayName": "MSVC, Release",
      "inherits": "windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "clangcl-debug",
      "displayName": "clang-cl, Debug",
      "inherits": "windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "clangcl-release",
      "displayName": "clang-cl, Release",
      "inherits": "windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "cl-release-tls",
      "displayName": "MSVC, Release, with core::net_tls (OpenSSL)",
      "inherits": "windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "cl",
        "CORE_CPP_WITH_TLS": "ON"
      }
    }
  ],
